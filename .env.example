# Copy to .env and fill in what you have. Every value below has a safe
# default (see app/settings.py) -- the app boots fully offline with none
# of these set, per Ticket #6.

HOUSEHOLD_DATABASE_URL=sqlite:///./data/household.db

# -- Inference (BUILD IT) ----------------------------------------------------
HOUSEHOLD_OLLAMA_BASE_URL=http://127.0.0.1:11434
HOUSEHOLD_OLLAMA_MODEL=qwen3:4b
HOUSEHOLD_VISION_MODEL=qwen2.5vl:3b
HOUSEHOLD_WHISPER_MODEL=base

# -- Remote recipe generation (primary) --------------------------------------
# Set these after creating API keys. Keep .env out of version control.
# The configured models are defaults only; choose models available to your
# provider account and usage tier.
HOUSEHOLD_GROQ_API_KEY=
HOUSEHOLD_GROQ_MODEL=openai/gpt-oss-120b
HOUSEHOLD_GEMINI_API_KEY=
HOUSEHOLD_GEMINI_MODEL=gemini-3.8-flash
HOUSEHOLD_RECIPE_PROVIDER_TIMEOUT_SECONDS=20

# -- Inference (SHIP IT) ------------------------------------------------------
# HOUSEHOLD_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# HOUSEHOLD_AWS_REGION=ap-south-1

# -- Google Calendar (guest/availability context, B019) ----------------------
# HOUSEHOLD_GOOGLE_CLIENT_ID=
# HOUSEHOLD_GOOGLE_CLIENT_SECRET=
# HOUSEHOLD_GOOGLE_TOKEN_ENCRYPTION_KEY=   # Fernet.generate_key()

# -- Zepto (commerce) ----------------------------------------------------------
HOUSEHOLD_ZEPTO_MOCK_ENABLED=true
# HOUSEHOLD_ZEPTO_CLIENT_ID=
# HOUSEHOLD_ZEPTO_CLIENT_SECRET=
# HOUSEHOLD_ZEPTO_TOKEN_ENCRYPTION_KEY=

# -- Pine Labs (payments) -- BLOCKED on RQ4/RQ5, see docs/honest-limits.md ---
HOUSEHOLD_PINELABS_MOCK_ENABLED=true
# HOUSEHOLD_PINELABS_CLIENT_ID=
# HOUSEHOLD_PINELABS_CLIENT_SECRET=
# HOUSEHOLD_PINELABS_TOKEN_ENCRYPTION_KEY=

# -- Delhivery (logistics) ----------------------------------------------------
HOUSEHOLD_DELHIVERY_MOCK_ENABLED=true
# HOUSEHOLD_DELHIVERY_API_KEY=

# -- Gnani (voice) -----------------------------------------------------------
# Text-to-speech is live and unblocked: RQ7 is a question about a microphone
# in a noisy kitchen, and there is no microphone in speech synthesis. Gnani's
# speech-to-TEXT leg is still gated on RQ7 -- see docs/honest-limits.md.
#
# Both of the next two are required for live audio. A key on its own is not
# enough: the mock flag has to be explicitly false as well, so a
# half-configured setup gets the offline mock and a startup warning rather
# than silent live spend.
HOUSEHOLD_GNANI_MOCK_ENABLED=true
# HOUSEHOLD_GNANI_API_KEY=
# HOUSEHOLD_GNANI_BASE_URL=https://api.vachana.ai/api/v1
# HOUSEHOLD_GNANI_TTS_MODEL=timbre-v2.5
# Speed is a top-level request field (range 0.85-1.15), not part of audio_config.
# HOUSEHOLD_GNANI_TTS_SPEED=1.0
#
# audio_config. MP3 because the bytes cross the response body on every cache
# miss with no CDN. bitrate applies only to mp3; encoding only to everything else.
# HOUSEHOLD_GNANI_AUDIO_CONTAINER=mp3
# HOUSEHOLD_GNANI_SAMPLE_RATE=24000
# HOUSEHOLD_GNANI_NUM_CHANNELS=1
# HOUSEHOLD_GNANI_SAMPLE_WIDTH=2
# HOUSEHOLD_GNANI_MP3_BITRATE=128k
# HOUSEHOLD_GNANI_AUDIO_ENCODING=linear_pcm
#
# The language used when the cook's profile language has no voice of its own.
# Hinglish: a code-mixed briefing is what an Indian home cook actually follows,
# and only a few languages have a voice configured in gnani_voice_map.
# HOUSEHOLD_GNANI_DEFAULT_LANGUAGE=hi-en
#
# MEASURED against the live API: 2000 chars returns 200, 2500 returns a 500.
# The default sits well clear of that boundary because the failure above it is
# an unhelpful server error, not a clean 400. See docs/honest-limits.md.
# HOUSEHOLD_GNANI_TTS_MAX_CHARS=1500
# HOUSEHOLD_GNANI_DAILY_SYNTHESIS_LIMIT=50
# HOUSEHOLD_RECIPE_AUDIO_TTL_SECONDS=1800

# -- Auth gate (Ticket #7) -----------------------------------------------------
# HOUSEHOLD_API_KEY=some-long-random-string
HOUSEHOLD_BIND_HOST=127.0.0.1

# -- Deterministic thresholds (Ticket #11) -------------------------------------
HOUSEHOLD_SPEND_TIER_GREEN_CEILING_INR=300
HOUSEHOLD_SPEND_TIER_RED_FLOOR_INR=1500
HOUSEHOLD_LOOP_UNCLOSED_TIMEOUT_HOURS=6
