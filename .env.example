# Copy to .env and fill in what you have. Every value below has a safe
# default (see app/settings.py) -- the app boots fully offline with none
# of these set, per Ticket #6.

HOUSEHOLD_DATABASE_URL=sqlite:///./data/household.db

# -- Inference (BUILD IT) ----------------------------------------------------
HOUSEHOLD_OLLAMA_BASE_URL=http://127.0.0.1:11434
HOUSEHOLD_OLLAMA_MODEL=qwen3:4b
HOUSEHOLD_VISION_MODEL=qwen2.5vl:3b
HOUSEHOLD_WHISPER_MODEL=base

# -- Remote recipe generation (primary) --------------------------------------
# Set these after creating API keys. Keep .env out of version control.
# The configured models are defaults only; choose models available to your
# provider account and usage tier.
HOUSEHOLD_GROQ_API_KEY=
HOUSEHOLD_GROQ_MODEL=openai/gpt-oss-120b
HOUSEHOLD_GEMINI_API_KEY=
HOUSEHOLD_GEMINI_MODEL=gemini-3.8-flash
HOUSEHOLD_RECIPE_PROVIDER_TIMEOUT_SECONDS=20

# -- Inference (SHIP IT) ------------------------------------------------------
# HOUSEHOLD_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# HOUSEHOLD_AWS_REGION=ap-south-1

# -- Google Calendar (guest/availability context, B019) ----------------------
# HOUSEHOLD_GOOGLE_CLIENT_ID=
# HOUSEHOLD_GOOGLE_CLIENT_SECRET=
# HOUSEHOLD_GOOGLE_TOKEN_ENCRYPTION_KEY=   # Fernet.generate_key()

# -- Zepto (commerce) ----------------------------------------------------------
HOUSEHOLD_ZEPTO_MOCK_ENABLED=true
# HOUSEHOLD_ZEPTO_CLIENT_ID=
# HOUSEHOLD_ZEPTO_CLIENT_SECRET=
# HOUSEHOLD_ZEPTO_TOKEN_ENCRYPTION_KEY=

# -- Pine Labs (payments) -- BLOCKED on RQ4/RQ5, see docs/honest-limits.md ---
HOUSEHOLD_PINELABS_MOCK_ENABLED=true
# HOUSEHOLD_PINELABS_CLIENT_ID=
# HOUSEHOLD_PINELABS_CLIENT_SECRET=
# HOUSEHOLD_PINELABS_TOKEN_ENCRYPTION_KEY=

# -- Delhivery (logistics) ----------------------------------------------------
HOUSEHOLD_DELHIVERY_MOCK_ENABLED=true
# HOUSEHOLD_DELHIVERY_API_KEY=

# -- Gnani (voice) -- BLOCKED on RQ7, see docs/honest-limits.md --------------
HOUSEHOLD_GNANI_MOCK_ENABLED=true
# HOUSEHOLD_GNANI_API_KEY=

# -- Auth gate (Ticket #7) -----------------------------------------------------
# HOUSEHOLD_API_KEY=some-long-random-string
HOUSEHOLD_BIND_HOST=127.0.0.1

# -- Deterministic thresholds (Ticket #11) -------------------------------------
HOUSEHOLD_SPEND_TIER_GREEN_CEILING_INR=300
HOUSEHOLD_SPEND_TIER_RED_FLOOR_INR=1500
HOUSEHOLD_LOOP_UNCLOSED_TIMEOUT_HOURS=6
